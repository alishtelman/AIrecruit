# Database
DATABASE_URL=postgresql+asyncpg://recruiting:recruiting@postgres:5432/recruiting

# Environment
APP_ENV=development
INTERVIEW_ENGINE_VERSION=v1
# Comma-separated roles for v2 rollout; empty = all roles when v2 is enabled
INTERVIEW_ENGINE_V2_ROLES=qa_engineer
CONVERSATIONAL_INTERVIEWER_MODE=false

# JWT
SECRET_KEY=change-me-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=airecruit_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
AUTH_ALLOW_BEARER=true
CSRF_TRUSTED_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=12
RATE_LIMIT_INTERVIEW_START_PER_MINUTE=30
RATE_LIMIT_INTERVIEW_MESSAGE_PER_MINUTE=240
RATE_LIMIT_TTS_PER_MINUTE=180
RATE_LIMIT_STT_PER_MINUTE=90


# AI
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat-v3-0324:free,qwen/qwen3-235b-a22b:free,nvidia/llama-3.1-nemotron-ultra-253b-v1:free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Talent Verification Platform
ALLOW_MOCK_AI=true
ELEVENLABS_API_KEY=
TTS_PROVIDER=groq
TTS_FALLBACK_PROVIDER=groq
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
MEDIA_SERVICE_URL=
RESUME_SERVICE_URL=
SANDBOX_SERVICE_URL=
LLM_SERVICE_URL=
MARKETPLACE_SERVICE_URL=
REPORT_SYNC_GENERATION_TIMEOUT_SECONDS=8
REPORT_ASSESSMENT_TIMEOUT_SECONDS=25
REPORT_MAX_AUTO_RETRIES=3
REPORT_RETRY_BASE_BACKOFF_SECONDS=2
REPORT_RETRY_MAX_BACKOFF_SECONDS=12
REPORT_LOCK_STALE_SECONDS=300
REPORT_WORKER_MODE=embedded
REPORT_WORKER_DRY_RUN=false
REPORT_WORKER_MAX_JOBS_PER_CYCLE=1
INTERNAL_WORKER_TOKEN=
RESEND_API_KEY=
FROM_EMAIL=AIRecruit <noreply@airecruit.app>

# App
APP_URL=http://localhost:3000
PLATFORM_ADMIN_EMAIL=admin@airecruit.dev
PLATFORM_ADMIN_PASSWORD=Admin12345!
PLATFORM_ADMIN_BOOTSTRAP=true

# File storage
UPLOAD_DIR=/app/uploads
RESUME_STORAGE_DIR=/app/storage/resumes
RECORDING_STORAGE_DIR=/app/storage/recordings
MAX_RESUME_SIZE_MB=10
MAX_RECORDING_SIZE_MB=250

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001

# Backend CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
